# --- generated by ./run.sh -----------------------------------------------------
# Everything here is a pure function of the committed inputs plus the raw data.
# Listed file by file rather than by directory, because the out_* folders also
# hold the interactive artefacts that MUST stay in git (asteroid_track.csv,
# corners.csv, and method 4's pre-built timeline.csv / sync_per_epoch.csv /
# track_mapping_report.csv).

figures/

