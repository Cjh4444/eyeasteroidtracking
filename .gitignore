analysis/method4/out_hybrid2/
analysis/method4/offsets_refit.csv
analysis/method4/differential_comparison.csv
analysis/method4/method_comparison.csv

# method 2 -- run.sh rebuilds these from the MATLAB logs and gaze.csv
