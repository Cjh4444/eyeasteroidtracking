# --- environment --------------------------------------------------------------
.venv/
.uv-cache/
__pycache__/
*.pyc

# --- macOS ---------------------------------------------------------------------
.DS_Store

# --- raw data too large for git ------------------------------------------------
# Scene videos are read only by the interactive stages (annotate_corners.py,
# track_live.py), whose outputs are committed per session. The fit never opens them.
data/**/*.mp4
data/**/3d_eye_states.csv
data/**/imu.csv

# Original downloads and the Pupil Cloud gaze-overlay export, kept locally only.
*.zip
lunar_blast_-_prelim_GAZE-OVERLAY_*/

# --- pipeline outputs ------------------------------------------------------------
# Per session keep session.json and the two interactive artefacts; everything else
# under a session is rebuilt by `lb.py run` / `lb.py fit`.
analysis/sessions/*/*
!analysis/sessions/*/session.json
!analysis/sessions/*/out_frame_annotate_method/
!analysis/sessions/*/out_track/
analysis/sessions/*/out_frame_annotate_method/*
analysis/sessions/*/out_track/*
!analysis/sessions/*/out_frame_annotate_method/corners.csv
!analysis/sessions/*/out_track/asteroid_track.csv
